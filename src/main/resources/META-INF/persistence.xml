<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="app3" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>es.upm.etsisi.poo.app3.data.model.user.User</class>
        <class>es.upm.etsisi.poo.app3.data.model.user.Cashier</class>
        <class>es.upm.etsisi.poo.app3.data.model.user.Client</class>

        <class>es.upm.etsisi.poo.app3.data.model.Entity</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.Purchasable</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.Product</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.BasicProduct</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.CustomProduct</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.ServiceProduct</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.products.TimeProduct</class>

        <class>es.upm.etsisi.poo.app3.data.model.shop.ticket.Ticket</class>
        <class>es.upm.etsisi.poo.app3.data.model.shop.ticket.TicketItem</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./db/app3_db;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.highlight_sql" value="false"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>